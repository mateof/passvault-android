<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local sharing. NEARBY_WIFI_DEVICES is required from Android 13; the
         older location permission is what earlier releases demanded for the same
         capability, which is why it is scoped with maxSdkVersion. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Updating the app from its own GitHub releases. Declaring this is not enough on its
         own: since Android 8 the user grants it per application in Settings, and the update
         screen sends them there rather than failing silently at the last step. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Pairing two phones by touching them. Not required: everything works without NFC, the
         six-digit comparison is still there for phones that have none, and a device with no NFC
         hardware should still be able to install this. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".PassVaultApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PassVault">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PassVault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Receiving a .tkpak from a messaging app. Matched by both the
                 registered media type and the extension, because most apps send
                 an unknown extension as application/octet-stream. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.passvault.tkpak" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/vnd.apple.pkpass" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <!-- The side of a tap that is touched. Exported because the system's NFC service is what
             binds to it, and permission-guarded so nothing else can. -->
        <service
            android:name=".share.NfcCardService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE">
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/nfc_apduservice" />
        </service>

        <!-- What the package installer reports back about a commit. Not exported: the only
             sender is this application's own session, through an explicit PendingIntent. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mateof.passvault.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- The camera hands its picture back by writing to a URI, and the URI has to belong
             to this app. Without a provider there is nowhere for a full-resolution photo to
             land, and the low-resolution thumbnail the camera returns instead is not enough
             pixels to read a barcode from. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
